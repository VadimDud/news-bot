# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_bot_token_here

# Bot username WITHOUT @ (required for the Telegram Login Widget on the web UI)
# Get it from @BotFather, e.g. my_news_bot
BOT_USERNAME=your_bot_username_here

# Your Telegram user ID (for admin access)
# Get it via @userinfobot
ADMIN_ID=123456789

# Translation API (optional - for auto-translate feature)
# You can use any translation API. Here are common options:
#
# Option 1: Google Translate (free, unofficial)
# No key needed - uses googletrans
#
# Option 2: DeepL API (high quality, needs key)
DEEPL_API_KEY=your_deepl_api_key_here
#
# Option 3: OpenAI API (great quality)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# HTTP proxy for Telegram API (routed through 3x-ui)
HTTP_PROXY=http://127.0.0.1:31533

# Telegram API mirror (optional, leave empty for default)
TELEGRAM_API_SERVER=

# Database path
DATABASE_PATH=data/bot.db

# Default AI agent (deepseek, gemini, dashscope)
DEFAULT_AGENT=deepseek

# Max seconds for interactive scan before timeout (default 120)
SCAN_TIMEOUT=120

# DeepSeek API for financial analysis (primary)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Gemini API for financial analysis (fallback)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Alibaba DashScope (Qwen) API for financial analysis (fallback)
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
DASHSCOPE_MODEL=qwen-turbo

# Auto-scan news interval (in seconds, default 3600 = 60 minutes)
# Set to a lower value for more frequent scanning
AUTO_SCAN_INTERVAL=3600

# --- ОФЗ-ИН (линкеры) macro alert ---
# Daily check of CBR data (USD/RUB rate + inflation % г/г + key rate). Sends a
# Telegram alert to ADMIN_ID when devaluation AND inflation are both declining —
# a sign that inflation-linked OFZ (52002/52003) may fall in price.
# Macro check interval in seconds (default 86400 = once a day)
# MACRO_CHECK_INTERVAL=86400
# Master switch (default true)
# LINKER_ALERT_ENABLED=true
# Optional separate chat for alerts; 0 = fall back to ADMIN_ID
# LINKER_ALERT_CHAT_ID=0
# Ruble strengthening threshold, % vs window start (default 3.0)
# FX_STRENGTH_THRESHOLD_PCT=3.0
# Inflation (г/г) drop threshold in percentage points (default 0.3)
# INFLATION_DROP_PP=0.3
# Minimum history window (days) before the trend check may fire (default 14)
# MACRO_WINDOW_DAYS=14

# --- News API aggregator (APITube, optional) ---
# Global news provider running in parallel with RSS. Without a key the bot
# keeps working on RSS sources only.
# Get a key at https://apitube.io (free tier: 10 req/min, preview content).
APITUBE_API_KEY=your_apitube_api_key_here
# APITUBE_BASE_URL=https://api.apitube.io
# Master switch (default false). APITube only indexes non-Russian/non-Russia
# news; enable only when a subscriber asks for it.
# NEWS_AGG_ENABLED=false
# Aggregated response cache TTL in seconds (default 600) — keeps usage within
# API limits during hourly auto-scans.
# NEWS_AGG_CACHE_TTL=600
# Optional OPR authority floor; 0 disables (default 0). Raise e.g. to 5 to keep
# only well-ranked sources, at the cost of losing niche/low-OPR outlets.
# NEWS_AGG_OPR_MIN=0
# Phase-3 enrichment: use provider sentiment / OPR for importance scoring
# NEWS_AGG_USE_SENTIMENT=true
# NEWS_AGG_USE_OPR=true
# Drop aggregated items matching junk-signal phrases (casino/deal-farm spam).
# RSS sources are trusted and unaffected. Default true.
# NEWS_AGG_JUNK_FILTER=true
# Minimum |score| to trust provider sentiment without an LLM call (default 0.5)
# NEWS_AGG_SENTIMENT_THRESHOLD=0.5
# Default language for category-driven aggregator queries
# NEWS_LANGUAGE=ru
# APITube filter language (default en). APITube does NOT index Russian-language
# news and rejects language.code=ru (ER0237), so keep this on a supported code.
# APITUBE_LANGUAGE=en
# IPTC Media Topics codes. Verify the exact values before changing them via
# https://api.apitube.io/v1/suggest/categories?prefix=<name>
# APITUBE_CATEGORY_FINANCE=medtop:04000000
# APITUBE_CATEGORY_POLITICS=medtop:11000000
# APITUBE_CATEGORY_SCIENCE_TECH=medtop:13000000

# Web interface (web_app.py)
# For local development use 127.0.0.1; set to 0.0.0.0 when exposing via Cloudflare Tunnel / Nginx
WEB_HOST=127.0.0.1
WEB_PORT=8080
# Optional: separate secret for web session cookies (defaults to BOT_TOKEN)
# WEB_COOKIE_SECRET=
# Set true when the web UI is served over HTTPS
# WEB_COOKIE_SECURE=false

# --- MOEX trading bot (trading_moex/ container) ---
# Backtest на истории MOEX (moexalgo) + live-торговля через T-Bank Invest API.
# Токен T-Bank: https://www.tinkoff.ru/invest/settings/ (Invest API раздел)
# TINKOFF_API_TOKEN=your_tinkoff_invest_token_here
# По умолчанию dry-run (реальные ордера не выставляются).
# TRADER_DRY_RUN=true
# Период опроса live-цикла, секунды
# TRADER_POLL_INTERVAL=60
# Тикеры MOEX для live-торговли через запятую
# TRADER_WATCH_TICKERS=SBER,LKOH
# Количество бумаг в одном ордере
# TRADER_QUANTITY=1
# Таймфрейм live-сигналов: 1min/5min/15min/hour/day/week/month
# TRADER_LIVE_INTERVAL=hour
# Веб-дашборд (отдельный порт, не пересекается с WEB_PORT новостного бота)
# TRADER_WEB_HOST=0.0.0.0
# TRADER_WEB_PORT=8081
# Пароль для входа в дашборд (обязателен)
# TRADER_WEB_PASSWORD=change_me
# Логин/пароль moex.com — только для Super Candles (обычные свечи не требуют авторизации)
# MOEX_LOGIN=
# MOEX_PASSWORD=
