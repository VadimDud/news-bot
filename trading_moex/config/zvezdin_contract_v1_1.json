{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeterministicStreamingStateMachineContract",
  "version": "1.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "hyperparameters", "indicators", "fsm_states", "zone_rules", "candle_rules", "execution_rules"],
  "properties": {
    "version": {"const": "1.1.0"},
    "usage": {"const": "TESTING_ONLY_NOT_FOR_TRADING"},
    "hyperparameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pivot_q", "atr_period", "ema_period", "n_waves", "exhaustion_eta", "zone_cluster_atr_ratio", "zone_width_atr_ratio", "true_breakout_beta", "max_touches", "max_age_bars", "rvol_days_D", "rvol_k_v", "rvol_k_std", "max_gap_atr_ratio", "risk_reward_ratio", "tick_size", "spread_model", "slippage_model", "fixed_spread", "fixed_slippage", "commission_rate", "max_concurrent_positions"],
      "properties": {
        "pivot_q": {"type": "integer", "minimum": 1, "default": 3},
        "atr_period": {"type": "integer", "minimum": 1, "default": 14},
        "ema_period": {"type": "integer", "minimum": 1, "default": 200},
        "n_waves": {"type": "integer", "minimum": 2, "default": 4},
        "wave_selection": {"enum": ["latest_mean", "last", "longest_mean", "longest"], "default": "latest_mean"},
        "reversal_setup_enabled": {"type": "boolean", "default": true},
        "compression_min_bars": {"type": "integer", "minimum": 1, "default": 2},
        "compression_max_bars": {"type": "integer", "minimum": 1, "default": 4},
        "compression_range_ratio": {"type": "number", "exclusiveMinimum": 0, "default": 0.6},
        "compression_body_ratio": {"type": "number", "exclusiveMinimum": 0, "default": 0.6},
        "reexpansion_ratio": {"type": "number", "exclusiveMinimum": 0, "default": 1.2},
        "impulse_art_eta": {"type": "number", "exclusiveMinimum": 0, "default": 0.85},
        "exhaustion_eta": {"type": "number", "exclusiveMinimum": 0, "default": 0.85},
        "zone_cluster_atr_ratio": {"type": "number", "exclusiveMinimum": 0, "default": 0.15},
        "zone_width_atr_ratio": {"type": "number", "exclusiveMinimum": 0, "default": 0.1},
        "true_breakout_beta": {"type": "number", "exclusiveMinimum": 0, "default": 0.25},
        "price_discovery_enabled": {"type": "boolean", "default": true},
        "max_touches": {"type": "integer", "minimum": 1, "default": 3},
        "max_age_bars": {"type": "integer", "minimum": 1, "default": 150},
        "zone_idle_max_bars": {"type": "integer", "minimum": 1, "default": 150},
        "stale_level_enabled": {"type": "boolean", "default": true},
        "stale_level_atr_min": {"type": "number", "exclusiveMinimum": 0, "default": 0.85},
        "stale_level_atr_max": {"type": "number", "exclusiveMinimum": 0, "default": 1.25},
        "stale_level_require_art": {"type": "boolean", "default": true},
        "uncertain_rsi_enabled": {"type": "boolean", "default": true},
        "rsi_period": {"type": "integer", "minimum": 1, "default": 14},
        "rsi_oversold": {"type": "number", "minimum": 0, "maximum": 100, "default": 35},
        "rsi_overbought": {"type": "number", "minimum": 0, "maximum": 100, "default": 65},
        "rvol_days_D": {"type": "integer", "minimum": 1, "default": 20},
        "rvol_k_v": {"type": "number", "minimum": 1, "default": 2.5},
        "rvol_k_std": {"type": "number", "minimum": 0, "default": 2},
        "max_gap_atr_ratio": {"type": "number", "minimum": 0, "default": 0.2},
        "risk_reward_ratio": {"type": "number", "exclusiveMinimum": 0, "default": 2.5},
        "tick_size": {"type": "number", "exclusiveMinimum": 0, "default": 0.01},
        "spread_model": {"enum": ["FIXED", "DYNAMIC_FROM_DATA"], "default": "FIXED"},
        "slippage_model": {"enum": ["FIXED", "VOLATILITY_SCALED"], "default": "FIXED"},
        "fixed_spread": {"type": "number", "minimum": 0, "default": 0},
        "fixed_slippage": {"type": "number", "minimum": 0, "default": 0},
        "slippage_atr_ratio": {"type": "number", "minimum": 0, "default": 0},
        "session_start_minute": {"type": "integer", "minimum": 0, "maximum": 1438, "default": 0},
        "session_end_minute": {"type": "integer", "minimum": 1, "maximum": 1439, "default": 1439},
        "slot_minutes": {"type": "integer", "minimum": 1, "default": 15},
        "zone_signal_mode": {"enum": ["STRICT", "TOUCH", "RELAXED_REJECTION", "NEAR"], "default": "STRICT"},
        "near_zone_atr_ratio": {"type": "number", "minimum": 0, "default": 0.1},
        "relaxation_pct": {"type": "number", "minimum": 0, "maximum": 100, "default": 0},
        "signal_mode": {"enum": ["AND", "SCORE"], "default": "AND"},
        "min_soft_score": {"type": "integer", "minimum": 0, "maximum": 5, "default": 5},
        "emergency_exit": {"type": "boolean", "default": true},
        "exhaustion_mode": {"enum": ["WAVE_ATR", "CURRENT_ATR"], "default": "WAVE_ATR"},
        "flat_at_day_boundary": {"type": "boolean", "default": true},
        "score_requires_flow": {"type": "boolean", "default": true},
        "component_window_acceleration": {"type": "integer", "minimum": 1, "default": 1},
        "component_window_atr_completion": {"type": "integer", "minimum": 1, "default": 1},
        "component_window_strong_level": {"type": "integer", "minimum": 1, "default": 1},
        "component_window_volume_participant": {"type": "integer", "minimum": 1, "default": 1},
        "component_window_reverse_impulse": {"type": "integer", "minimum": 1, "default": 1},
        "volume_entry_filter": {"type": "boolean", "default": true},
        "post_entry_volume_management": {"type": "boolean", "default": false},
        "volume_stop_buffer_atr_ratio": {"type": "number", "minimum": 0, "default": 0.1},
        "volume_target_extension_r": {"type": "number", "minimum": 0, "default": 0.5},
        "commission_rate": {"type": "number", "minimum": 0, "default": 0.0003},
        "max_concurrent_positions": {"type": "integer", "minimum": 1, "default": 1}
      }
    },
    "ticker_profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "component_window_acceleration": {"type": "integer", "minimum": 1},
          "component_window_atr_completion": {"type": "integer", "minimum": 1},
          "component_window_strong_level": {"type": "integer", "minimum": 1},
          "component_window_volume_participant": {"type": "integer", "minimum": 1},
          "component_window_reverse_impulse": {"type": "integer", "minimum": 1},
          "signal_mode": {"enum": ["AND", "SCORE"]},
          "min_soft_score": {"type": "integer", "minimum": 0, "maximum": 5},
          "risk_reward_ratio": {"type": "number", "exclusiveMinimum": 0},
          "flat_at_day_boundary": {"type": "boolean"},
          "emergency_exit": {"type": "boolean"}
        }
      }
    },
    "indicators": {"type": "object", "additionalProperties": false, "required": ["atr", "ema", "rvol", "wave_atr"], "properties": {"atr": {"$ref": "#/$defs/IndicatorDef"}, "ema": {"$ref": "#/$defs/IndicatorDef"}, "rvol": {"$ref": "#/$defs/IndicatorDef"}, "wave_atr": {"$ref": "#/$defs/IndicatorDef"}}},
    "fsm_states": {"type": "object", "additionalProperties": false, "required": ["zone_statuses", "position_statuses", "reversal_phases"], "properties": {"zone_statuses": {"type": "array", "items": {"type": "string"}}, "position_statuses": {"type": "array", "items": {"type": "string", "enum": ["IDLE", "SIGNAL_PENDING", "IN_POSITION"]}}, "reversal_phases": {"type": "array", "items": {"enum": ["IDLE", "IMPULSE_REACHED", "COMPRESSION", "RE_EXPANSION"]}}}},
    "zone_rules": {"type": "object", "additionalProperties": false, "required": ["cluster_logic", "frozen_geometry", "breakout_logic", "touch_logic", "tie_breaker"], "properties": {"cluster_logic": {"type": "string"}, "frozen_geometry": {"type": "string"}, "breakout_logic": {"type": "string"}, "touch_logic": {"type": "string"}, "tie_breaker": {"type": "string"}}},
    "candle_rules": {"type": "object", "additionalProperties": false, "required": ["single_candle_pinbar", "two_candle_engulfing"], "properties": {"single_candle_pinbar": {"type": "string"}, "two_candle_engulfing": {"type": "string"}}},
    "execution_rules": {"type": "object", "additionalProperties": false, "required": ["tick_priority", "order_type", "worst_case_intrabar", "pnl_formula"], "properties": {"tick_priority": {"type": "array", "items": {"type": "string"}}, "order_type": {"const": "OPEN_NEXT_BAR_MARKET"}, "worst_case_intrabar": {"const": true}, "pnl_formula": {"type": "string"}}}
  },
  "$defs": {
    "IndicatorDef": {"type": "object", "additionalProperties": false, "required": ["name", "formula", "lookback_source"], "properties": {"name": {"type": "string"}, "formula": {"type": "string"}, "lookback_source": {"type": "string"}}},
    "Zone": {"type": "object", "additionalProperties": false, "required": ["zone_id", "zone_type", "center", "width", "created_at", "eligible_from", "touches", "age", "status"], "properties": {"zone_id": {"type": "integer"}, "zone_type": {"enum": ["RESISTANCE", "SUPPORT"]}, "center": {"type": "number"}, "width": {"type": "number", "exclusiveMinimum": 0}, "created_at": {"type": "integer"}, "eligible_from": {"type": "integer"}, "touches": {"type": "integer", "minimum": 0}, "age": {"type": "integer", "minimum": 0}, "status": {"enum": ["ACTIVE", "EXPIRED_TOUCHES", "EXPIRED_AGE", "INVALIDATED_BROKEN"]}}}
  }
}
