# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_bot_token_here

# Bot username WITHOUT @ (required for the Telegram Login Widget on the web UI)
# Get it from @BotFather, e.g. my_news_bot
BOT_USERNAME=your_bot_username_here

# Your Telegram user ID (for admin access)
# Get it via @userinfobot
ADMIN_ID=123456789

# Translation API (optional - for auto-translate feature)
# You can use any translation API. Here are common options:
#
# Option 1: Google Translate (free, unofficial)
# No key needed - uses googletrans
#
# Option 2: DeepL API (high quality, needs key)
DEEPL_API_KEY=your_deepl_api_key_here
#
# Option 3: OpenAI API (great quality)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# HTTP proxy for Telegram API (routed through 3x-ui)
HTTP_PROXY=http://127.0.0.1:31533

# Telegram API mirror (optional, leave empty for default)
TELEGRAM_API_SERVER=

# Database path
DATABASE_PATH=data/bot.db

# Default AI agent (deepseek, gemini, dashscope)
DEFAULT_AGENT=deepseek

# Max seconds for interactive scan before timeout (default 120)
SCAN_TIMEOUT=120

# DeepSeek API for financial analysis (primary)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Gemini API for financial analysis (fallback)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Alibaba DashScope (Qwen) API for financial analysis (fallback)
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
DASHSCOPE_MODEL=qwen-turbo

# Auto-scan news interval (in seconds, default 3600 = 60 minutes)
# Set to a lower value for more frequent scanning
AUTO_SCAN_INTERVAL=3600

# --- News API aggregator (APITube, optional) ---
# Global news provider running in parallel with RSS. Without a key the bot
# keeps working on RSS sources only.
# Get a key at https://apitube.io (free tier: 10 req/min, preview content).
APITUBE_API_KEY=your_apitube_api_key_here
# APITUBE_BASE_URL=https://api.apitube.io
# Master switch (default true)
# NEWS_AGG_ENABLED=true
# Aggregated response cache TTL in seconds (default 600) — keeps usage within
# API limits during hourly auto-scans.
# NEWS_AGG_CACHE_TTL=600
# Optional OPR authority floor; 0 disables (default 0). Raise e.g. to 5 to keep
# only well-ranked sources, at the cost of losing niche/low-OPR outlets.
# NEWS_AGG_OPR_MIN=0
# Phase-3 enrichment: use provider sentiment / OPR for importance scoring
# NEWS_AGG_USE_SENTIMENT=true
# NEWS_AGG_USE_OPR=true
# Minimum |score| to trust provider sentiment without an LLM call (default 0.5)
# NEWS_AGG_SENTIMENT_THRESHOLD=0.5
# Default language for category-driven aggregator queries
# NEWS_LANGUAGE=ru
# IPTC Media Topics codes. Verify the exact values before changing them via
# https://api.apitube.io/v1/suggest/categories?prefix=<name>
# APITUBE_CATEGORY_FINANCE=medtop:04000000
# APITUBE_CATEGORY_POLITICS=medtop:11000000
# APITUBE_CATEGORY_SCIENCE_TECH=medtop:13000000

# Web interface (web_app.py)
# For local development use 127.0.0.1; set to 0.0.0.0 when exposing via Cloudflare Tunnel / Nginx
WEB_HOST=127.0.0.1
WEB_PORT=8080
# Optional: separate secret for web session cookies (defaults to BOT_TOKEN)
# WEB_COOKIE_SECRET=
# Set true when the web UI is served over HTTPS
# WEB_COOKIE_SECURE=false
